# Copie este arquivo para .env e preencha os valores.
# O .env real é ignorado pelo Git (.gitignore) — nunca versione.
#
# Regra geral: variáveis com prefixo VITE_ são embutidas no bundle do
# navegador e ficam PÚBLICAS. Tudo que for segredo precisa ficar sem o
# prefixo e ser lido apenas em código de servidor (process.env).

# =====================================================================
# Supabase — client (público, embutido no bundle)
# =====================================================================
SUPABASE_URL="https://seu-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="chave-publicavel-anon"

# Mesmos valores expostos ao frontend. São chaves publicáveis (role=anon),
# protegidas por RLS — não são segredos.
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="chave-publicavel-anon"

# src/integrations/supabase/env.ts resolve os dois pares acima e ainda aceita
# VITE_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY como apelido da chave publicável
# (é o nome usado no painel do Supabase). Basta um par estar preenchido.

# Usado por src/lib/backups.functions.ts para montar a URL do Storage.
SUPABASE_PROJECT_ID="seu-project-id"
# Mantido por compatibilidade; hoje nenhum código lê esta variável.
VITE_SUPABASE_PROJECT_ID="seu-project-id"

# =====================================================================
# Segredos de servidor
# =====================================================================
# Em produção (Lovable Cloud / Cloudflare) configure-os no painel de
# Secrets, não neste arquivo. Localmente, preencha no .env para que as
# rotas de API e as server functions funcionem.

# OBRIGATÓRIA para qualquer operação administrativa. Ignora RLS por
# completo — nunca exponha ao cliente nem use com prefixo VITE_.
# Sem ela, src/integrations/supabase/client.server.ts lança em runtime e
# derrubam-se: atendimento, backups, equipe, nfse, whatsapp e as 3 rotas
# em src/routes/api/public/.
SUPABASE_SERVICE_ROLE_KEY="chave-service-role"

# Autentica o cron de backup diário (header `x-backup-token` em
# POST /api/public/hooks/backup-diario). Gere um valor de alta entropia.
BACKUP_WEBHOOK_TOKEN="token-aleatorio-longo"

# --- Focus NFe (emissão de NFS-e) ---
# O token usado depende de `focus_ambiente` do emitente: "producao" usa o
# _PROD; qualquer outro valor usa o _HML e cai no _PROD se o _HML faltar.
FOCUS_NFE_TOKEN_PROD="token-focus-producao"
FOCUS_NFE_TOKEN_HML="token-focus-homologacao"
# Valida o webhook de mudança de status (POST /api/public/focusnfe/webhook).
FOCUS_WEBHOOK_TOKEN="token-webhook-focus"

# IA da plataforma: atendimento assistido, análise de exames e fallback de
# TTS quando o Piper local está fora do ar.
LOVABLE_API_KEY="lovable-api-key"

# Assina as requisições de impressão do QZ Tray (PEM, chave privada).
QZ_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."

# Opcional: sobrescreve o endpoint de TTS (Piper). Se ausente, usa o
# servidor Tailscale padrão definido em src/routes/api/public/tts.ts.
TTS_UPSTREAM_URL="https://seu-servidor/api/tts"

# Planejada, ainda não usada: aparece apenas no TODO de integração
# bancária em src/lib/boleto.functions.ts (emissão de boletos).
# BANCO_API_KEY="api-key-do-banco"

# Nina — memória de sessão (minutos de inatividade antes de iniciar nova sessão)
NINA_SESSION_MEMORY_TTL_MINUTES=240
# Nina — prazo de espera por resposta do paciente (minutos)
NINA_PATIENT_RESPONSE_TIMEOUT_MINUTES=30
